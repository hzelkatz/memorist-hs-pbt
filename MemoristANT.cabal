cabal-version:      3.0
name:               MemoristANT
version:            0.1.0.0
synopsis:           Property-based testing of lazy cost
-- description:
license:            MIT
license-file:       LICENSE
build-type:         Simple
-- extra-doc-files:
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Memorist.Memorist
        -- Memorist.MemoristStrict
        Memorist.Data.List
        Memorist.Example.List
        Memorist.Example.ListSort
        Memorist.Example.Queue.Base
        Memorist.Example.Queue.Bankers
        Memorist.Example.Queue.Batched
        Memorist.Example.Queue.BatchedLazy
        Memorist.Example.NewtonRaphson
        -- ** Not done:
        Memorist.Example.ListInf
    -- other-modules:
        Memorist.Base.Thunk
        Memorist.Base.Core
        Memorist.Base.ANT
        Memorist.Base.Extension
        Memorist.Data.Interface
        Memorist.Data.Interface.Data
        Memorist.Data.Interface.Demand
        Memorist.Infer.Infer
        -- Memorist.Base.Strict
        Memorist.Example.Util
    -- No export:
        -- Memorist.Example.Test
    -- other-extensions:
    build-depends: 
        base >=4.14 && <5,
        containers >=0.6,
        mtl >=2.3 && < 2.4,
        QuickCheck >=2.17 && < 3
    hs-source-dirs:
        src
    default-language: GHC2021
